{
    "name": "extcode/cart-events",
    "type": "typo3-cms-extension",
    "description": "Shopping Cart(s) for TYPO3 - Event Extension",
    "homepage": "https://cart.extco.de",
    "license": [
        "GPL-2.0-or-later"
    ],
    "keywords": [
        "TYPO3 CMS",
        "Shopping Cart",
        "cart",
        "events"
    ],
    "authors": [
        {
            "name": "Daniel Gohlke",
            "email": "ext@extco.de",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/extcode/cart_events/issues"
    },
    "autoload": {
        "psr-4": {
            "Extcode\\CartEvents\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Extcode\\CartEvents\\Tests\\": "Tests"
        }
    },
    "config": {
        "allow-plugins": {
            "typo3/cms-composer-installers": true,
            "typo3/class-alias-loader": true,
            "sbuerk/typo3-cmscomposerinstallers-testingframework-bridge": true,
            "phpstan/extension-installer": true
        },
        "vendor-dir": ".Build/vendor",
        "bin-dir": ".Build/bin"
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "cart_events",
            "web-dir": ".Build/public"
        }
    },
    "require": {
        "php": "~8.2.0 || ~8.3.0 || ~8.4.0",
        "ext-json": "*",
        "ext-pdo": "*",
        "extcode/cart": "^11.3",
        "typo3/cms-core": "^13.4",
        "typo3/cms-extbase": "^13.4",
        "typo3/cms-fluid": "^13.4"
    },
    "require-dev": {
        "codappix/typo3-php-datasets": "^2.1",
        "codeception/codeception": "^5.0",
        "codeception/module-db": "^3.1",
        "codeception/module-webdriver": "^4.0",
        "friendsofphp/php-cs-fixer": "^3.16",
        "helmich/typo3-typoscript-lint": "^3.1",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "saschaegerer/phpstan-typo3": "^2.1",
        "spaze/phpstan-disallowed-calls": "^4.7",
        "staabm/phpstan-todo-by": "^0.3",
        "typo3/cms-fluid-styled-content": "^13.4",
        "typo3/cms-install": "^13.4",
        "typo3/testing-framework": "^8.0"
    },
    "scripts": {
        "project:cgl": "Build/Scripts/cgl.sh",
        "project:cgl:fix": "Build/Scripts/cgl.sh --fix",
        "project:lint": [
            "@project:lint:php",
            "@project:lint:typoscript",
            "@project:lint:xml",
            "@project:lint:yaml"
        ],
        "project:lint:php": "Build/Scripts/lint-php.sh",
        "project:lint:typoscript": "Build/Scripts/lint-typoscript.sh",
        "project:lint:xml": "Build/Scripts/lint-xml.sh",
        "project:lint:yaml": "Build/Scripts/lint-yaml.sh",
        "project:phpstan": "Build/Scripts/phpstan.sh",
        "project:test:unit": "Build/Scripts/phpunit.sh unit",
        "project:test:functional": "Build/Scripts/phpunit.sh functional",
        "project:test:acceptance": [
            "Composer\\Config::disableProcessTimeout",
            "Build/Scripts/acceptance.sh"
        ],
        "test:rector:process": [
            ".Build/bin/rector process"
        ],
        "test:rector:process:dry-run": [
            ".Build/bin/rector process --dry-run"
        ]
    },
    "suggest": {
        "typo3/cms-form": "^13.4"
    }
}
